    },
    {
      "event": "Stop",
      "matcher": null,
      "runner": "node",
      "script": "log-stop-model.js",
      "why": "응답 종료 시 모델 기록"
    },
    {
      "event": "PostToolUse",
      "matcher": "ExitPlanMode",
      "runner": "node",
      "script": "log-plan.js",
      "why": "확정된 계획 보존"
    },
    {
      "event": "PostToolUse",
      "matcher": "Bash|Write|Edit",
      "runner": "python",
      "script": "deliverable_guard.py",
      "why": "산출물(docx·pptx·hwpx)이 만들어지면 장르별 감사를 자동으로 돌린다"
    },
    {
      "event": "PostToolUse",
      "matcher": "Write|Edit",
      "runner": "python",
      "script": "docx_kit_guard.py",
      "why": "python-docx로 문서를 «조립»하는데 docx-editing 스킬을 안 쓰면 알린다"
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "runner": "python",
      "script": "heredoc_guard.py",
      "why": "heredoc·`python -` 차단. 조용히 망가지거나 셸이 영원히 멈춘다"
    }
  ]
